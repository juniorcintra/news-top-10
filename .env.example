# ─── Database (Supabase / PostgreSQL) ──────────────────────────────────────────
# Pooler connection - used by the app at runtime (PgBouncer, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@aws-X-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection - used by Prisma CLI for migrations (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@aws-X-region.pooler.supabase.com:5432/postgres"

# ─── WhatsApp (Twilio) ──────────────────────────────────────────────────────────
# Twilio Console → https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# WhatsApp-enabled number (sandbox: +14155238886)
TWILIO_WHATSAPP_FROM="+14155238886"

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ─── Check-in Scheduler (cron, Mon–Fri only) ───────────────────────────────────
MORNING_CRON="30 8 * * 1-5"
EVENING_CRON="30 20 * * 1-5"

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
