# Database (Supabase)
# Pooler connection - used by the app at runtime (PgBouncer, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@aws-X-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection - used by Prisma CLI for migrations (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@aws-X-region.pooler.supabase.com:5432/postgres"


# WhatsApp (Green API - https://green-api.com)
WHATSAPP_API_KEY=""
WHATSAPP_INSTANCE_ID=""
WHATSAPP_RECIPIENT="5511999999999"

# Scheduler (cron expression)
CRON_SCHEDULE="0 7 * * *"

# App
NODE_ENV="development"
PORT=3000
